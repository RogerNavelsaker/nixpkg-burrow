{
  "name": "@os-eco/burrow-cli-nix",
  "type": "module",
  "version": "0.3.15",
  "description": "Nix packaging scaffold for @os-eco/burrow-cli",
  "license": "MIT",
  "scripts": {
    "show-manifest": "bun --eval \"console.log(await Bun.file('nix/package-manifest.json').text())\"",
    "sync:source": "bun run sync:npm-source",
    "sync:manifest": "bun run sync:npm-source",
    "sync:npm-source": "bun run scripts/sync-from-npm.ts",
    "postinstall": "bun x bun2nix -o bun.nix"
  },
  "dependencies": {
    "@os-eco/burrow-cli": "0.3.15"
  },
  "devDependencies": {
    "bun2nix": "2.0.8"
  }
}
